    return raw ? JSON.parse(raw) : fallback;
  } catch (e) {
    return fallback;
  }
}

function safeSaveStorage(key, value) {
  try {
    window.localStorage.setItem(key, JSON.stringify(value));
    return true;
  } catch (e) {
    return false;
  }
}

function safeRemoveStorage(key) {
  try {
    window.localStorage.removeItem(key);
  } catch (e) {
    // ignore
  }
}

let userState = safeLoadStorage(STORAGE_STATE_KEY, null);
if (userState === null) {
  userState = safeLoadStorage(STORAGE_STATE_FALLBACK_KEY, {});
}
let customItems = safeLoadStorage(STORAGE_CUSTOM_KEY, []);
let currentView = "table";
let activePreset = "ALL";
let searchTimer = null;

function showToast(message, isWarn) {
  const el = document.getElementById("toastBanner");
  el.textContent = message;
  el.classList.toggle("warn", Boolean(isWarn));
  el.classList.add("show");
}

function getAllDatabases() {
  const map = new Map();
  INITIAL_DATA.forEach(item => map.set(item.name, item));
  customItems.forEach(item => map.set(item.name, item));
  return Array.from(map.values());
}

function saveUserState() {
  safeSaveStorage(STORAGE_STATE_KEY, userState);
}

function escapeHtml(str) {
  return String(str ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function accessBadgeClass(access) {
  if (access === "Off-Campus") return "badge-off";
  if (access === "On-Campus Only") return "badge-on";
  return "badge-open";
}

function populateSubjectFilter() {
  const select = document.getElementById("subjectFilter");
  const current = select.value;
  const subjects = new Set();
  getAllDatabases().forEach(d => (d.subjects || []).forEach(s => subjects.add(s)));
  select.innerHTML = '<option value="ALL">すべての主題分野</option>';
  Array.from(subjects).sort((a, b) => a.localeCompare(b, "ja")).forEach(s => {
    const opt = document.createElement("option");
    opt.value = s;
    opt.textContent = s;
    select.appendChild(opt);
  });
  if (Array.from(select.options).some(o => o.value === current)) {
    select.value = current;
  }
}

function updateKPIs(allData) {
  document.getElementById("headerCount").textContent = allData.length;
  document.getElementById("kpiTotal").textContent = allData.length;
  document.getElementById("kpiOffCampus").textContent = allData.filter(d => d.access === "Off-Campus").length;
  document.getElementById("kpiPriorityS").textContent = allData.filter(d => d.priority === "S").length;
  document.getElementById("kpiHighDiff").textContent = allData.filter(d => d.post_grad_difficulty === "極高" || d.post_grad_difficulty === "高").length;
  document.getElementById("kpiDone").textContent = allData.filter(d => userState[d.name] && userState[d.name].done).length;
}

function getFilteredData() {
  const q = document.getElementById("searchInput").value.trim().toLowerCase();
  const subj = document.getElementById("subjectFilter").value;
  const acc = document.getElementById("accessFilter").value;
  const prio = document.getElementById("priorityFilter").value;
  const diff = document.getElementById("diffFilter").value;
  const sortBy = document.getElementById("sortSelect").value;

  const list = getAllDatabases().filter(d => {
    if (activePreset === "S" && d.priority !== "S") return false;
    if (activePreset === "SA" && d.priority !== "S" && d.priority !== "A") return false;
    if (activePreset === "RARE" && d.post_grad_difficulty !== "極高" && d.post_grad_difficulty !== "高") return false;
    if (activePreset === "OPEN" && d.access !== "Open") return false;
    if (activePreset === "DONE" && !(userState[d.name] && userState[d.name].done)) return false;

    if (subj !== "ALL" && !(d.subjects || []).includes(subj)) return false;
    if (acc !== "ALL" && d.access !== acc) return false;
    if (prio !== "ALL" && d.priority !== prio) return false;
    if (diff !== "ALL" && d.post_grad_difficulty !== diff) return false;
    if (q) {
      const hay = [
        d.id ?? "",
        d.name,
        ...(d.subjects || []),
        ...(d.doc_types || []),
        ...(d.languages || []),
        d.content,
        d.potential,
        (userState[d.name] && userState[d.name].memo) || ""
      ].join(" ").toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  list.sort((a, b) => {
    if (sortBy === "priority") {
      return (PRIORITY_RANK[a.priority] || 9) - (PRIORITY_RANK[b.priority] || 9)
        || (DIFF_RANK[a.post_grad_difficulty] || 9) - (DIFF_RANK[b.post_grad_difficulty] || 9)
        || (Number(a.id) || 9999) - (Number(b.id) || 9999);
    }
    if (sortBy === "id") return (Number(a.id) || 9999) - (Number(b.id) || 9999);
    if (sortBy === "name") return a.name.localeCompare(b.name, "ja");
    if (sortBy === "access") {
      return (ACCESS_RANK[a.access] || 9) - (ACCESS_RANK[b.access] || 9) || a.name.localeCompare(b.name, "ja");
    }
    if (sortBy === "diff") {
      return (DIFF_RANK[a.post_grad_difficulty] || 9) - (DIFF_RANK[b.post_grad_difficulty] || 9)
        || (PRIORITY_RANK[a.priority] || 9) - (PRIORITY_RANK[b.priority] || 9);
    }
    return 0;
  });
  return list;
}

function toggleDone(name, checked) {
  userState[name] = Object.assign({}, userState[name], { done: checked });
  saveUserState();
  render();
}

function updateMemo(name, val) {
  userState[name] = Object.assign({}, userState[name], { memo: val });
  saveUserState();
}

function render() {
  const allData = getAllDatabases();
  updateKPIs(allData);
  const rows = getFilteredData();
  document.getElementById("visibleCount").textContent = rows.length;

  const tbody = document.getElementById("tableBody");
  const cards = document.getElementById("cardsContainer");

  if (rows.length === 0) {
    if (currentView === "table") {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:28px;color:#64748b;">条件に一致するデータベースはありません。</td></tr>';
      cards.innerHTML = "";
    } else {
      cards.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:28px;color:#64748b;">条件に一致するデータベースはありません。</div>';
      tbody.innerHTML = "";
    }
    return;
  }

  // Render only the active view to keep 366-item mobile Chrome performance fast
  if (currentView === "table") {
    cards.innerHTML = "";
    tbody.innerHTML = rows.map(d => {
      const st = userState[d.name] || {};
      const subjectsHtml = (d.subjects || []).map(s => `<span class="tag">${escapeHtml(s)}</span>`).join("");
      const typesHtml = (d.doc_types || []).join(" / ");
      const langsHtml = (d.languages || []).join(", ");
      const idLabel = d.id ? `公式ID: ${d.id}` : "公式一覧";
      return `<tr class="${st.done ? "done-row" : ""}">
        <td style="text-align:center;">
          <input type="checkbox" aria-label="${escapeHtml(d.name)}を完了にする" ${st.done ? "checked" : ""} class="js-done-toggle" data-name="${escapeHtml(d.name)}">
        </td>
        <td>
          <a class="db-name" href="${escapeHtml(d.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(d.name)}</a>
          <div><span class="badge ${accessBadgeClass(d.access)}">${escapeHtml(d.access)}</span></div>
          <div class="sub-meta">${idLabel}</div>
          <input class="memo-input" type="text" placeholder="活用メモを保存..." value="${escapeHtml(st.memo || "")}" data-name="${escapeHtml(d.name)}">
        </td>
        <td>
          <div>${subjectsHtml}</div>
          <div class="sub-meta"><strong>資料タイプ：</strong>${escapeHtml(typesHtml)}</div>
          <div class="sub-meta"><strong>言語：</strong>${escapeHtml(langsHtml)}</div>
        </td>
        <td>${escapeHtml(d.content)}</td>
        <td>
          <div style="margin-bottom:6px;">
            <span class="badge badge-${escapeHtml(d.priority)}">優先度 ${escapeHtml(d.priority)}</span>
            <span class="tag">卒業後代替難易度：${escapeHtml(d.post_grad_difficulty)}</span>
          </div>
          <div>${escapeHtml(d.potential)}</div>
        </td>
      </tr>`;
    }).join("");
  } else {
    tbody.innerHTML = "";
    cards.innerHTML = rows.map(d => {
      const st = userState[d.name] || {};
      const subjectsHtml = (d.subjects || []).map(s => `<span class="tag">${escapeHtml(s)}</span>`).join("");
      const idLabel = d.id ? `ID:${d.id}` : "";
      return `<article class="db-card ${st.done ? "done-row" : ""}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
          <div>
            <a class="db-name" href="${escapeHtml(d.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(d.name)}</a>
            <div>
              <span class="badge ${accessBadgeClass(d.access)}">${escapeHtml(d.access)}</span>
              <span class="badge badge-${escapeHtml(d.priority)}">優先度 ${escapeHtml(d.priority)}</span>
              <span class="tag">代替難易度：${escapeHtml(d.post_grad_difficulty)}</span>
              ${idLabel ? `<span class="tag">${escapeHtml(idLabel)}</span>` : ""}
            </div>
          </div>
          <label style="font-size:11.5px;white-space:nowrap;cursor:pointer;">
            <input type="checkbox" ${st.done ? "checked" : ""} class="js-done-toggle" data-name="${escapeHtml(d.name)}"> 完了
          </label>
        </div>
        <div>
          <div class="card-section-title">② 分類</div>
          ${subjectsHtml}
          <div class="sub-meta">${escapeHtml((d.doc_types || []).join(" / "))} ｜ ${escapeHtml((d.languages || []).join(", "))}</div>
        </div>
        <div>
          <div class="card-section-title">③ 内容</div>
          <div style="font-size:12.5px;">${escapeHtml(d.content)}</div>
        </div>
        <div>
          <div class="card-section-title">④ 今後の活用可能性</div>
          <div style="font-size:12.5px;">${escapeHtml(d.potential)}</div>
        </div>
        <input class="memo-input" type="text" placeholder="活用メモを保存..." value="${escapeHtml(st.memo || "")}" data-name="${escapeHtml(d.name)}">
      </article>`;
    }).join("");
  }
}

function setView(view) {
  currentView = view;
  const isTable = view === "table";
  document.getElementById("tableContainer").style.display = isTable ? "block" : "none";
  document.getElementById("cardsContainer").classList.toggle("active", !isTable);
  document.getElementById("btnTableView").classList.toggle("active", isTable);
  document.getElementById("btnCardView").classList.toggle("active", !isTable);
  render();
}

function setPreset(preset) {
  activePreset = preset;
  document.querySelectorAll(".chip").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.preset === preset);
  });
  render();
}

function exportCsv() {
  const rows = getFilteredData();
  const headers = ["公式ID", "名前", "URL", "利用区分", "主題分野", "資料タイプ", "言語", "内容", "優先度", "卒業後代替難易度", "今後の活用可能性", "完了", "メモ"];
  const esc = v => '"' + String(v ?? "").replace(/"/g, '""') + '"';
  const lines = [headers.map(esc).join(",")];
  rows.forEach(d => {
    const st = userState[d.name] || {};
    lines.push([
      d.id ?? "",
      d.name,
      d.url,
      d.access,
      (d.subjects || []).join(" / "),
      (d.doc_types || []).join(" / "),
      (d.languages || []).join(" / "),
      d.content,
      d.priority,
      d.post_grad_difficulty,
      d.potential,
      st.done ? "済" : "",
      st.memo || ""
    ].map(esc).join(","));
  });
  const csvContent = "\uFEFF" + lines.join("\r\n");
  const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "utokyo_database_catalog_all366.csv";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function exportMergedHtml() {
  const merged = getAllDatabases();
  const safeJson = JSON.stringify(merged).replace(/<\//g, "<\\/");
  const cloneDoc = document.documentElement.cloneNode(true);
  const cloneTbody = cloneDoc.querySelector("#tableBody");
  if (cloneTbody) cloneTbody.innerHTML = "";
  const cloneCards = cloneDoc.querySelector("#cardsContainer");
  if (cloneCards) {
    cloneCards.innerHTML = "";
    cloneCards.classList.remove("active");
  }
  const cloneModal = cloneDoc.querySelector("#importModal");
  if (cloneModal) cloneModal.classList.remove("open");
  const cloneToast = cloneDoc.querySelector("#toastBanner");
  if (cloneToast) {
    cloneToast.classList.remove("show");
    cloneToast.textContent = "";
  }
  const cloneTableWrap = cloneDoc.querySelector("#tableContainer");
  if (cloneTableWrap) cloneTableWrap.style.display = "";
  const cloneBtnTable = cloneDoc.querySelector("#btnTableView");
  if (cloneBtnTable) cloneBtnTable.classList.add("active");
  const cloneBtnCard = cloneDoc.querySelector("#btnCardView");
  if (cloneBtnCard) cloneBtnCard.classList.remove("active");
  const clonePortal = cloneDoc.querySelector("#portalPanel");
  if (clonePortal) clonePortal.classList.remove("open");

  const scripts = cloneDoc.querySelectorAll("script");
  const mainScript = scripts[scripts.length - 1];
  const pattern = /\/\*__INITIAL_DATA_START__\*\/[\s\S]*?\/\*__INITIAL_DATA_END__\*\//;
  mainScript.textContent = mainScript.textContent.replace(
    pattern,
    "/*__INITIAL_DATA_START__*/\nconst INITIAL_DATA = " + safeJson + ";\n/*__INITIAL_DATA_END__*/"
  );
  const fullHtml = "<!DOCTYPE html>\n" + cloneDoc.outerHTML;
  const blob = new Blob([fullHtml], { type: "text/html;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "index.html";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast(`統合済みHTML（全${merged.length}件内蔵・index.html）をダウンロードしました。`, false);
}

function normalizeImportedItem(item) {
  return {
    id: item.id ?? null,
    name: String(item.name).trim(),
    url: item.url || "https://www.lib.u-tokyo.ac.jp/ja/library/contents/database",
    access: ["Off-Campus", "On-Campus Only", "Open"].includes(item.access) ? item.access : "Off-Campus",
    subjects: Array.isArray(item.subjects) && item.subjects.length ? item.subjects : ["総合分野"],
    doc_types: Array.isArray(item.doc_types) && item.doc_types.length ? item.doc_types : ["その他"],
    languages: Array.isArray(item.languages) && item.languages.length ? item.languages : ["日本語"],
    content: item.content || "",
    priority: ["S", "A", "B", "C"].includes(item.priority) ? item.priority : "B",
    post_grad_difficulty: ["極高", "高", "中", "低"].includes(item.post_grad_difficulty) ? item.post_grad_difficulty : "高",
    potential: item.potential || ""
  };
}

function openImportModal() {
  document.getElementById("importError").textContent = "";
  document.getElementById("importFileStatus").textContent = "";
  document.getElementById("importModal").classList.add("open");
}

function closeImportModal() {
  document.getElementById("importModal").classList.remove("open");
}

function applyJsonImport() {
  const errEl = document.getElementById("importError");
  errEl.textContent = "";
  const rawText = document.getElementById("importTextarea").value.trim();
  if (!rawText) {
    errEl.textContent = "JSONファイルを選択するか、テキストエリアへJSON配列を貼り付けてください。";
    return;
  }
  try {
    const parsed = JSON.parse(rawText);
    if (!Array.isArray(parsed)) {
      throw new Error("JSONのルートは配列（[...]）である必要があります。");
    }
    const protectExisting = document.getElementById("chkProtectExisting").checked;
    const initialIds = new Set(INITIAL_DATA.filter(d => d.id !== null && d.id !== undefined).map(d => Number(d.id)));
    const initialNames = new Set(INITIAL_DATA.map(d => d.name));

    const customMap = new Map(customItems.map(item => [item.name, item]));
    let addedCount = 0;
    let skippedCount = 0;

    parsed.forEach((item, idx) => {
      if (!item || typeof item.name !== "string" || !item.name.trim()) {
        throw new Error(`${idx + 1}件目に有効な "name" がありません。`);
      }
      const norm = normalizeImportedItem(item);
      const isInitialMatch = initialNames.has(norm.name) || (norm.id !== null && initialIds.has(Number(norm.id)));
      if (protectExisting && isInitialMatch) {
        skippedCount += 1;
        return;
      }
      customMap.set(norm.name, norm);
      addedCount += 1;
    });

    customItems = Array.from(customMap.values());
    const saved = safeSaveStorage(STORAGE_CUSTOM_KEY, customItems);
    populateSubjectFilter();
    render();
    closeImportModal();
    document.getElementById("importTextarea").value = "";
    document.getElementById("importFileInput").value = "";

    const totalNow = getAllDatabases().length;
    if (saved) {
      showToast(`インポート完了：${addedCount}件を取り込みました（既収録保護スキップ：${skippedCount}件／現在合計：${totalNow}件）。`, false);
    } else {
      showToast(`メモリへ${addedCount}件取り込みました（現在合計：${totalNow}件）。localStorageへ保存できない環境のため「統合済みHTMLを保存」で保管してください。`, true);
    }
  } catch (e) {
    errEl.textContent = "取り込みエラー: " + e.message;
  }
}

document.getElementById("searchInput").addEventListener("input", () => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(render, 120);
});

["subjectFilter", "accessFilter", "priorityFilter", "diffFilter", "sortSelect"].forEach(id => {
  document.getElementById(id).addEventListener("change", render);
});

document.querySelectorAll(".chip").forEach(btn => {
  btn.addEventListener("click", () => setPreset(btn.dataset.preset));
});

document.getElementById("btnTableView").addEventListener("click", () => setView("table"));
document.getElementById("btnCardView").addEventListener("click", () => setView("card"));
document.getElementById("btnPortalToggle").addEventListener("click", () => {
  document.getElementById("portalPanel").classList.toggle("open");
});
document.getElementById("btnExportCsv").addEventListener("click", exportCsv);
document.getElementById("btnExportHtml").addEventListener("click", exportMergedHtml);
document.getElementById("btnResetFilters").addEventListener("click", () => {
  document.getElementById("searchInput").value = "";
  document.getElementById("subjectFilter").value = "ALL";
  document.getElementById("accessFilter").value = "ALL";
  document.getElementById("priorityFilter").value = "ALL";
  document.getElementById("diffFilter").value = "ALL";
  document.getElementById("sortSelect").value = "priority";
  setPreset("ALL");
});

document.getElementById("btnImportOpen").addEventListener("click", openImportModal);
document.getElementById("btnImportClose").addEventListener("click", closeImportModal);
document.getElementById("btnImportApply").addEventListener("click", applyJsonImport);
document.getElementById("btnClearImported").addEventListener("click", () => {
  customItems = [];
  safeRemoveStorage(STORAGE_CUSTOM_KEY);
  populateSubjectFilter();
  render();
  closeImportModal();
  showToast(`追加インポート分を初期化しました（初期収録 ${INITIAL_DATA.length}件に戻しました）。`, false);
});

document.getElementById("importModal").addEventListener("click", (e) => {
  if (e.target.id === "importModal") closeImportModal();
});

document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") closeImportModal();
});

document.getElementById("importFileInput").addEventListener("change", (e) => {
  const file = e.target.files && e.target.files[0];
  const statusEl = document.getElementById("importFileStatus");
  const errEl = document.getElementById("importError");
  statusEl.textContent = "";
  errEl.textContent = "";
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    const content = String(reader.result || "");
    document.getElementById("importTextarea").value = content;
    try {
      const parsed = JSON.parse(content);
      if (Array.isArray(parsed)) {
        statusEl.textContent = `ファイル読込完了：${file.name}（${parsed.length}件を検出）。下の「取り込む」ボタンを押してください。`;
      } else {
        errEl.textContent = "選択したJSONは配列形式（[...]）ではありません。";
      }
    } catch (err) {
      errEl.textContent = "JSONの構文解析に失敗しました: " + err.message;
    }
  };
  reader.onerror = () => {
    errEl.textContent = "ファイルの読み込みに失敗しました。";
  };
  reader.readAsText(file, "utf-8");
});

document.addEventListener("change", (e) => {
  if (e.target.classList.contains("js-done-toggle")) {
    toggleDone(e.target.dataset.name, e.target.checked);
  }
});

document.addEventListener("input", (e) => {
  if (e.target.classList.contains("memo-input")) {
    updateMemo(e.target.dataset.name, e.target.value);
  }
});

populateSubjectFilter();
if (window.innerWidth <= 768) {
  setView("card");
} else {
  render();
}
</script>
</body>
