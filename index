<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1e3a5f">
<title>東京大学附属図書館 全366データベース 整理・活用戦略カタログ</title>
<style>
  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-muted: #f1f5f9;
    --border: #e2e8f0;
    --border-strong: #cbd5e1;
    --text: #0f172a;
    --text-secondary: #475569;
    --text-muted: #64748b;
    --primary: #1e3a5f;
    --primary-light: #eff6ff;
    --accent: #2563eb;
    --s-bg: #fef2f2; --s-text: #991b1b; --s-border: #fecaca;
    --a-bg: #fff7ed; --a-text: #9a3412; --a-border: #fed7aa;
    --b-bg: #eff6ff; --b-text: #1e40af; --b-border: #bfdbfe;
    --c-bg: #f1f5f9; --c-text: #475569; --c-border: #cbd5e1;
    --off-bg: #ecfdf5; --off-text: #065f46; --off-border: #a7f3d0;
    --on-bg: #fefce8; --on-text: #854d0e; --on-border: #fde68a;
    --open-bg: #f0f9ff; --open-text: #075985; --open-border: #bae6fd;
    --radius: 10px;
    --shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    overflow-x: clip;
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic UI", "Meiryo", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    font-size: 14px;
  }
  header {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
    color: #ffffff;
    padding: 26px 24px 22px;
    border-bottom: 3px solid #3b82f6;
  }
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
  }
  header h1 {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  header .subtitle {
    margin: 0;
    color: #cbd5e1;
    font-size: 13px;
  }
  header .subtitle a {
    color: #93c5fd;
    text-decoration: underline;
  }
  .toast {
    display: none;
    margin: 14px 0 0;
    padding: 12px 16px;
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #86efac;
    background: #f0fdf4;
    color: #166534;
    box-shadow: var(--shadow);
  }
  .toast.show { display: block; }
  .toast.warn {
    border-color: #fde68a;
    background: #fffbeb;
    color: #92400e;
  }
  .notice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 18px 0;
  }
  .notice-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 12.5px;
    box-shadow: var(--shadow);
  }
  .notice-box.info {
    border-left-color: #0f766e;
    background: #f0fdfa;
  }
  .notice-box strong {
    display: block;
    margin-bottom: 4px;
    font-size: 13px;
    color: var(--text);
  }
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }
  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    box-shadow: var(--shadow);
  }
  .kpi-label {
    font-size: 11.5px;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .kpi-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--primary);
    line-height: 1.2;
  }
  .kpi-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .controls {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .chip {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface-muted);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }
  .controls-row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  .control-group label {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }
  input[type="text"], select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    font-size: 13px;
    background: #fff;
    color: var(--text);
  }
  input[type="text"]:focus, select:focus {
    outline: 2px solid #93c5fd;
    border-color: var(--accent);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  button, .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  button:hover, .btn:hover {
    background: var(--surface-muted);
    border-color: #94a3b8;
  }
  button.primary {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }
  button.primary:hover {
    background: #172d4a;
  }
  button.accent {
    background: #0f766e;
    color: #fff;
    border-color: #0f766e;
  }
  button.accent:hover {
    background: #115e59;
  }
  button.active {
    background: var(--primary-light);
    color: var(--accent);
    border-color: var(--accent);
  }
  .result-meta {
    font-size: 12.5px;
    color: var(--text-secondary);
    font-weight: 600;
  }
  .portal-panel {
    display: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .portal-panel.open {
    display: block;
  }
  .portal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: var(--shadow);
    margin-bottom: 24px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1060px;
  }
  thead th {
    background: #f1f5f9;
    color: var(--text);
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    padding: 12px 12px;
    border-bottom: 2px solid var(--border-strong);
    position: sticky;
    top: 0;
    z-index: 2;
  }
  tbody td {
    padding: 12px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-size: 13px;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  tbody tr:hover {
    background: #f8fafc;
  }
  tbody tr.done-row {
    background: #f0fdf4;
  }
  .db-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 4px;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .db-name:hover {
    text-decoration: underline;
    color: var(--accent);
  }
  .badge {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid transparent;
    margin: 2px 4px 2px 0;
    white-space: nowrap;
  }
  .badge-off { background: var(--off-bg); color: var(--off-text); border-color: var(--off-border); }
  .badge-on { background: var(--on-bg); color: var(--on-text); border-color: var(--on-border); }
  .badge-open { background: var(--open-bg); color: var(--open-text); border-color: var(--open-border); }
  .badge-S { background: var(--s-bg); color: var(--s-text); border-color: var(--s-border); }
  .badge-A { background: var(--a-bg); color: var(--a-text); border-color: var(--a-border); }
  .badge-B { background: var(--b-bg); color: var(--b-text); border-color: var(--b-border); }
  .badge-C { background: var(--c-bg); color: var(--c-text); border-color: var(--c-border); }
  .tag {
    display: inline-block;
    padding: 2px 6px;
    background: var(--surface-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 11px;
    margin: 2px 4px 2px 0;
  }
  .sub-meta {
    font-size: 11.5px;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .memo-input {
    width: 100%;
    margin-top: 6px;
    padding: 5px 7px;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-size: 11.5px;
    color: var(--text);
    background: #fff;
  }
  .cards-grid {
    display: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }
  .cards-grid.active {
    display: grid;
  }
  .db-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .db-card > div {
    min-width: 0;
  }
  .db-card.done-row {
    border-color: #86efac;
    background: #f0fdf4;
  }
  .card-section-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }
  .strategy-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: var(--shadow);
  }
  .strategy-section h2 {
    margin: 0 0 12px;
    font-size: 16px;
    color: var(--primary);
    border-bottom: 2px solid var(--border);
    padding-bottom: 8px;
  }
  .strategy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .strategy-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    font-size: 12.5px;
  }
  .strategy-card h3 {
    margin: 0 0 6px;
    font-size: 13.5px;
    color: var(--primary);
  }
  .modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .modal-backdrop.open {
    display: flex;
  }
  .modal {
    background: #fff;
    border-radius: 12px;
    max-width: 740px;
    width: 100%;
    padding: 20px 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    max-height: 90vh;
    overflow-y: auto;
  }
  .modal h3 {
    margin: 0 0 8px;
    font-size: 16px;
    color: var(--primary);
  }
  .file-drop {
    border: 2px dashed var(--border-strong);
    border-radius: 8px;
    padding: 14px;
    background: var(--bg);
    margin-bottom: 12px;
  }
  .file-drop label {
    display: block;
    font-weight: 700;
    font-size: 12.5px;
    margin-bottom: 6px;
    color: var(--primary);
  }
  .file-drop input[type="file"] {
    max-width: 100%;
  }
  .modal textarea {
    width: 100%;
    min-height: 140px;
    padding: 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }
  .option-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0;
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
    padding: 16px 0 32px;
  }
  @media (max-width: 1100px) {
    .controls-row { grid-template-columns: 1fr 1fr 1fr; }
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .strategy-grid { grid-template-columns: repeat(2, 1fr); }
    .notice-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    header {
      padding: 18px 14px 16px;
    }
    header h1 {
      font-size: 18px;
      line-height: 1.35;
    }
    .container {
      padding: 0 12px;
    }
    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .kpi-grid .kpi-card:first-child {
      grid-column: 1 / -1;
    }
    .kpi-card {
      padding: 10px 12px;
    }
    .kpi-value {
      font-size: 20px;
    }
    .controls {
      padding: 12px;
    }
    .controls-row {
      grid-template-columns: 1fr;
    }
    input[type="text"],
    select,
    .memo-input,
    .modal textarea {
      font-size: 16px;
    }
    .toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }
    .toolbar .btn-group #btnResetFilters,
    .modal .btn-group #btnImportApply {
      grid-column: 1 / -1;
    }
    button, .btn {
      justify-content: center;
      min-height: 40px;
      padding: 8px 10px;
      font-size: 12px;
    }
    .portal-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .db-card {
      padding: 13px;
    }
    .strategy-grid {
      grid-template-columns: 1fr;
    }
    .modal {
      padding: 16px;
    }
  }
</style>
</head>
<body>

<header>
  <div class="container">
    <h1>東京大学附属図書館 全366データベース 整理・活用戦略カタログ</h1>
    <p class="subtitle">
      出典：<a href="https://www.lib.u-tokyo.ac.jp/ja/library/contents/database" target="_blank" rel="noopener noreferrer">東京大学附属図書館 データベース一覧</a>（全 <span id="headerCount">366</span>件完全収録・クレンジング＆全件活用可能性評価済み）
    </p>
  </div>
</header>

<main class="container">
  <div id="toastBanner" class="toast" role="status" aria-live="polite"></div>

  <div class="notice-grid">
    <div class="notice-box info">
      <strong>全366件完全収録・データクレンジング済み</strong>
      公式一覧の全366件を内蔵し、抽出ノイズ除去・誤アンカー2件（ID:209 ProQuest Ebook Central／ID:262 Web of Science）の修復・サービス終了1件（ID:419 理科年表プレミアム、2026/11/18終了）の明示・全件の活用可能性評価を完了しています。チェックとメモは閲覧中ブラウザ内にのみ保存されます。
    </div>
    <div class="notice-box">
      <strong>規約順守・利用上の前提</strong>
      各データベースのダウンロード・印刷は「個人の学術研究・教育目的」「必要な最小限の量（システマティック・ダウンロード禁止）」「機械的アクセス禁止」「生成AIツールへの無断投入禁止」の規約範囲内で運用してください（参照：<a href="https://www.lib.u-tokyo.ac.jp/ja/library/literacy/user-guide/campus/caution" target="_blank" rel="noopener noreferrer">電子リソース利用上の注意</a>）。
    </div>
  </div>

  <section class="kpi-grid" aria-label="サマリー指標">
    <div class="kpi-card">
      <div class="kpi-label">全データベース収録数</div>
      <div class="kpi-value"><span id="kpiTotal">366</span> <span style="font-size:14px;color:#64748b;font-weight:500;">件（完全網羅）</span></div>
      <div class="kpi-sub">公式14主題分野すべてをカバー</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Off-Campus（学外可）</div>
      <div class="kpi-value" id="kpiOffCampus">0</div>
      <div class="kpi-sub">UTokyo Account リモート対応</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">優先度 S（最優先）</div>
      <div class="kpi-value" id="kpiPriorityS">0</div>
      <div class="kpi-sub">実務・研究価値と希少性が極大</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">卒業後代替難易度：極高／高</div>
      <div class="kpi-value" id="kpiHighDiff">0</div>
      <div class="kpi-sub">卒業後の継続アクセス障壁が高いDB</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">確認・活用チェック済み</div>
      <div class="kpi-value" id="kpiDone">0</div>
      <div class="kpi-sub">端末ブラウザ内に自動保存</div>
    </div>
  </section>

  <section class="controls" aria-label="検索・フィルタ">
    <div class="quick-chips" role="group" aria-label="クイック絞り込み">
      <button type="button" class="chip active" data-preset="ALL">すべて（全件）</button>
      <button type="button" class="chip" data-preset="S">優先度 S のみ</button>
      <button type="button" class="chip" data-preset="SA">優先度 S＋A（重要DB）</button>
      <button type="button" class="chip" data-preset="RARE">卒業後代替困難（極高・高）</button>
      <button type="button" class="chip" data-preset="OPEN">卒業後も無料（Open）</button>
      <button type="button" class="chip" data-preset="DONE">チェック済みのみ</button>
    </div>

    <div class="controls-row">
      <div class="control-group">
        <label for="searchInput">キーワード検索（名前・内容・活用可能性・メモ）</label>
        <input type="text" id="searchInput" placeholder="例：会社法、有価証券、AI、医学、判例、Scopus...">
      </div>
      <div class="control-group">
        <label for="subjectFilter">② 分類（東大公式・主題分野）</label>
        <select id="subjectFilter">
          <option value="ALL">すべての主題分野</option>
        </select>
      </div>
      <div class="control-group">
        <label for="accessFilter">利用区分</label>
        <select id="accessFilter">
          <option value="ALL">すべて</option>
          <option value="Off-Campus">Off-Campus（学外可）</option>
          <option value="On-Campus Only">On-Campus Only（学内限定）</option>
          <option value="Open">Open（無料公開）</option>
        </select>
      </div>
      <div class="control-group">
        <label for="priorityFilter">④ 活用優先度</label>
        <select id="priorityFilter">
          <option value="ALL">すべて</option>
          <option value="S">S（最優先）</option>
          <option value="A">A（高）</option>
          <option value="B">B（中）</option>
          <option value="C">C（専門・参考）</option>
        </select>
      </div>
      <div class="control-group">
        <label for="diffFilter">卒業後の代替難易度</label>
        <select id="diffFilter">
          <option value="ALL">すべて</option>
          <option value="極高">極高（公共館等でも困難）</option>
          <option value="高">高（来館閲覧・有料契約のみ）</option>
